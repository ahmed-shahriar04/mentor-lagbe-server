# MentorLagbe Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration (replace with your Atlas connection string in .env)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=mentorlagbe

# Stripe Secret Key (Test Mode)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT Secret for standalone/fallback verification
JWT_SECRET=super_secret_jwt_key_mentorlagbe_2026

# Google OAuth Client ID (Optional on Server)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
